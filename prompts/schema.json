{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question Set",
  "description": "One section's worth of exam questions. One file per section, at data/<chapterId>/<sectionId>.json",
  "type": "object",
  "required": ["id", "chapter", "section", "profile", "questions"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ch[0-9]{2}-s[0-9]{2}$",
      "description": "e.g. ch03-s02"
    },
    "chapter": { "type": "integer", "minimum": 1 },
    "chapterTitle": { "type": "string" },
    "section": { "type": "integer", "minimum": 1 },
    "sectionTitle": { "type": "string" },
    "profile": {
      "type": "string",
      "description": "Key from prompts/profiles.json used to generate this set"
    },
    "sourceFile": {
      "type": "string",
      "description": "Filename of the PDF this was generated from, for traceability"
    },
    "generatedAt": { "type": "string", "format": "date" },
    "questionTarget": {
      "type": "integer",
      "minimum": 1,
      "description": "How many questions this section should have. Set it when the section is too short to support the default 50 without repeating facts."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "stem",
        "choices",
        "answer",
        "explanation",
        "whyWrong",
        "topic",
        "bloom",
        "difficulty"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{2,3}$" },
        "type": {
          "enum": ["single", "multi"],
          "description": "single = exactly one correct choice; multi = two or more"
        },
        "stem": { "type": "string", "minLength": 10 },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["a", "b", "c", "d", "e"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["a", "b", "c", "d", "e"] },
          "description": "Ids of correct choices. Length 1 when type is single."
        },
        "explanation": {
          "type": "string",
          "minLength": 20,
          "description": "1-3 sentences on WHY the answer is correct. Not a restatement of the choice."
        },
        "whyWrong": {
          "type": "object",
          "description": "One entry per incorrect choice id, naming the specific misconception it represents",
          "additionalProperties": { "type": "string", "minLength": 10 }
        },
        "topic": {
          "type": "string",
          "minLength": 3,
          "description": "3-6 word concept label, reused across questions so results can be grouped by topic"
        },
        "bloom": {
          "enum": ["recall", "understand", "apply", "analyze"],
          "description": "Cognitive level, used for the per-level results breakdown"
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sourceRef": {
          "type": "string",
          "description": "Where in the PDF this came from, e.g. '§3.7.1, p. 274'"
        }
      }
    }
  }
}
